# Ghost Content API (opcional — "Explorar" y botón Laboratorio por proyecto)
PUBLIC_GHOST_URL=https://learn.peranto.app
GHOST_CONTENT_API_KEY=
# En Ghost, etiqueta cada artículo con slug = ghostTag del proyecto (criteria, lumo, auradid…).
# Si hay ≥1 post con esa etiqueta, la landing muestra «Laboratorio» → learn.peranto.app/tag/{slug}/

# SEO — Google Search Console (propiedad peranto.app)
# PUBLIC_GOOGLE_SITE_VERIFICATION=pegue_aqui_el_token

# Métricas sin cookies — Plausible self-host en /plausible (npm run plausible:up)
# PUBLIC_ANALYTICS_PROVIDER=plausible
# PUBLIC_PLAUSIBLE_DOMAIN=peranto.app
# PUBLIC_PLAUSIBLE_SCRIPT_URL=https://analytics.peranto.app/js/script.outbound-links.tagged-events.js
# Cloud alternativo: https://plausible.io/js/script.outbound-links.tagged-events.js
# Eventos custom: CTA *, Project Panel, CTA Demo — ver plausible/README.md

# Umami Cloud: https://cloud.umami.is — plan gratuito limitado
# PUBLIC_ANALYTICS_PROVIDER=umami
# PUBLIC_UMAMI_WEBSITE_ID=su-website-id
# PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# --- GitHub Actions (repo cryptohumano/peranto-website) ---
# Settings → Secrets and variables → Actions → New repository secret
# Mismos nombres que arriba. El build funciona sin secrets (Explorar vacío, sin analytics).
