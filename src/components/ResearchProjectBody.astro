---
import CriteriaGallery from './CriteriaGallery.astro';
import ProjectDemoLink from './ProjectDemoLink.astro';
import ProjectGallery from './ProjectGallery.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { criteriaFeatureKeys } from '../config/criteria-features';
import { andinoScreenshots } from '../config/andino-screenshots';
import { emergencyScreenshots } from '../config/emergency-screenshots';
import { lumoFeatureKeys } from '../config/lumo-features';
import { lumoScreenshots } from '../config/lumo-screenshots';
import { perantoProtocolScreenshots } from '../config/peranto-protocol-screenshots';
import { yohualliScreenshots } from '../config/yohualli-screenshots';
import type { ResearchProject } from '../config/research-projects';
import { buildContactHref } from '../lib/contact-intent';

interface Props {
  lang: Lang;
  project: ResearchProject;
  labUrl?: string | null;
}

const { lang, project, labUrl = null } = Astro.props;
const t = useTranslations(lang);

const lumoContactHref = buildContactHref(lang, {
  interest: 'lumo',
  topic: lang === 'es' ? 'Lumo — consulta de adopción' : 'Lumo — adoption inquiry',
  ref: 'lumo-adoption',
  path: `/${lang}/#investigacion`,
});

const isLiveApp =
  project.status === 'live' &&
  project.href.startsWith('https://') &&
  !project.href.includes('github.com');

function projectHref() {
  return project.githubHref ?? project.href;
}
---

{
  project.id === 'criteria' && (
    <>
      <p class="project-panel__lead">{t(project.descKey)}</p>

      <div class="mt-8">
        <h4 class="mb-4 font-mono text-xs font-medium uppercase tracking-[0.15em] text-deep">
          {t('research.projects.criteria.features.label')}
        </h4>
        <ul class="grid gap-3 sm:grid-cols-2">
          {
            criteriaFeatureKeys.map((key) => (
              <li class="flex gap-2 text-sm leading-relaxed text-ink-muted">
                <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-bright" aria-hidden="true" />
                {t(key)}
              </li>
            ))
          }
        </ul>
      </div>

      <CriteriaGallery lang={lang} class="mt-10" />

      <div class="mt-8 rounded-lg border border-line/80 bg-paper/80 p-5 sm:p-6">
        <h4 class="font-display text-lg font-medium text-ink">
          {t('research.projects.criteria.support.title')}
        </h4>
        <p class="mt-2 text-sm leading-relaxed text-ink-muted sm:text-base">
          {t('research.projects.criteria.support.body')}
        </p>
      </div>

      <div class="project-panel__cta-row">
        <a
          href={project.href}
          class="inline-flex items-center rounded-md bg-gradient-to-r from-deep to-bright px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-deep/15 transition hover:brightness-110"
          target="_blank"
          rel="noopener noreferrer"
          data-track-event="CTA Criteria"
          data-track-placement="investigacion"
          data-track-project="criteria"
        >
          {t('research.projects.criteria.cta.visit')}
        </a>
        {
          project.subscribeHref && (
            <a
              href={project.subscribeHref}
              class="inline-flex items-center rounded-md border border-line px-5 py-2.5 text-sm font-medium text-ink transition hover:border-deep/40 hover:bg-paper-dark/50"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t('research.projects.criteria.cta.support')}
            </a>
          )
        }
        {
          labUrl && (
            <a
              href={labUrl}
              class="inline-flex items-center rounded-md border border-deep/30 bg-accent-soft/50 px-5 py-2.5 text-sm font-medium text-deep transition hover:border-deep/50"
              target="_blank"
              rel="noopener"
            >
              {t('research.projects.lab')}
            </a>
          )
        }
        {
          project.githubHref && (
            <a
              href={project.githubHref}
              class="inline-flex items-center rounded-md border border-line px-5 py-2.5 text-sm font-medium text-ink transition hover:border-deep/40 hover:bg-paper-dark/50"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t('research.link.github')}
            </a>
          )
        }
      </div>
    </>
  )
}

{
