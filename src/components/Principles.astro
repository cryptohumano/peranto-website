---
import SectionLabel from './SectionLabel.astro';
import type { Lang, UIKey } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const principles: { title: UIKey; desc: UIKey }[] = [
  { title: 'principles.possession.title', desc: 'principles.possession.desc' },
  { title: 'principles.open.title', desc: 'principles.open.desc' },
  { title: 'principles.rigor.title', desc: 'principles.rigor.desc' },
  { title: 'principles.transparency.title', desc: 'principles.transparency.desc' },
];
---

<section id="principios" class="border-b border-line bg-night py-20 text-white sm:py-28">
  <div class="section-width">
    <SectionLabel label={t('principles.label')} tone="dark" />
    <h2 class="mb-12 font-display text-3xl font-medium sm:text-4xl">{t('principles.title')}</h2>
    <ol class="grid gap-8 sm:grid-cols-2">
      {
        principles.map((item, i) => (
          <li class="border-t border-white/15 pt-6">
            <span class="font-mono text-sm text-bright/80">0{i + 1}</span>
            <h3 class="mt-2 font-display text-xl font-medium">{t(item.title)}</h3>
            <p class="mt-3 leading-relaxed text-white/70">{t(item.desc)}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
