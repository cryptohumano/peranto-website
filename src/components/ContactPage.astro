---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import type { Lang } from '../i18n/ui';
import { getAlternateLang, pathForLang, useTranslations } from '../i18n/ui';
import { siteConfig } from '../config/site';
import { parseContactPrefill } from '../lib/contact-intent';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const altLang = getAlternateLang(lang);

const sent = Astro.url.searchParams.get('enviado') === '1';
const error = Astro.url.searchParams.get('error');
const prefill = parseContactPrefill(lang, Astro.url.searchParams);
const hasContext = Boolean(prefill.topic);

const interestOptions =
  lang === 'es'
    ? [
        { value: 'criteria', label: 'CriterIA' },
        { value: 'lumo', label: 'Lumo' },
        { value: 'research', label: 'Investigación / co-desarrollo' },
        { value: 'support', label: 'Apoyo / mecenazgo' },
        { value: 'identity', label: 'Identidad / AuraDID' },
        { value: 'otro', label: 'Otro' },
      ]
    : [
        { value: 'criteria', label: 'CriterIA' },
        { value: 'lumo', label: 'Lumo' },
        { value: 'research', label: 'Research / co-development' },
        { value: 'support', label: 'Support / patronage' },
        { value: 'identity', label: 'Identity / AuraDID' },
        { value: 'otro', label: 'Other' },
      ];
---

<BaseLayout
  lang={lang}
  title={t('contact.meta.title')}
  description={t('contact.meta.description')}
>
  <Header lang={lang} />
  <main>
    <section class="border-b border-line bg-gradient-to-b from-accent-soft/50 to-paper py-16 sm:py-20">
      <div class="section-width">
        <p class="text-sm font-medium uppercase tracking-wider text-deep">{t('contact.label')}</p>
        <h1 class="mt-3 font-display text-4xl font-medium text-ink sm:text-5xl">{t('contact.title')}</h1>
        <p class="mt-4 max-w-2xl text-lg text-ink-muted">{t('contact.lead')}</p>
      </div>
    </section>

    <section class="section-width grid gap-12 py-16 lg:grid-cols-[1.1fr_0.9fr]">
      {
        sent && (
          <p class="lg:col-span-2 rounded-md border border-bright/40 bg-accent-soft px-4 py-3 text-sm text-ink">
            {t('contact.success')}
          </p>
        )
      }
      {
        error === 'missing' && (
          <p class="lg:col-span-2 rounded-md border border-line bg-paper-dark/60 px-4 py-3 text-sm text-ink">
            {t('contact.error.missing')}
          </p>
        )
      }
      {
        (error === 'db' || error === 'send') && (
          <p class="lg:col-span-2 rounded-md border border-line bg-paper-dark/60 px-4 py-3 text-sm text-ink">
            {t('contact.error.db')} {siteConfig.email}
          </p>
        )
      }
      {
        error && error !== 'missing' && error !== 'db' && error !== 'send' && (
          <p class="lg:col-span-2 rounded-md border border-line bg-paper-dark/60 px-4 py-3 text-sm text-ink">
            {t('contact.error.generic')} {siteConfig.email}
          </p>
        )
      }
      {
        hasContext && !sent && (
          <p class="lg:col-span-2 rounded-md border border-line bg-accent-soft/40 px-4 py-3 text-sm text-ink">
            {t('contact.prefill')}
            <strong class="font-semibold"> «{prefill.topic}»</strong>.
          </p>
        )
      }

      <form class="space-y-5" method="POST" action="/api/contact">
        <input type="hidden" name="lang" value={lang} />
        {prefill.ref && <input type="hidden" name="ref" value={prefill.ref} />}
        {prefill.path && <input type="hidden" name="sourcePath" value={prefill.path} />}
        {prefill.topic && <input type="hidden" name="topic" value={prefill.topic} />}

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="text-sm font-medium text-ink">{t('contact.field.name')}</label>
            <input
              id="name"
              name="name"
              required
              class="mt-2 w-full rounded-md border border-line bg-paper px-4 py-3 text-sm outline-none focus:border-deep"
            />
          </div>
          <div>
            <label for="email" class="text-sm font-medium text-ink">{t('contact.field.email')}</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="mt-2 w-full rounded-md border border-line bg-paper px-4 py-3 text-sm outline-none focus:border-deep"
            />
          </div>
        </div>

        <div>
          <label for="company" class="text-sm font-medium text-ink">{t('contact.field.company')}</label>
          <input
            id="company"
            name="company"
            class="mt-2 w-full rounded-md border border-line bg-paper px-4 py-3 text-sm outline-none focus:border-deep"
          />
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="phone" class="text-sm font-medium text-ink">{t('contact.field.phone')}</label>
            <input
              id="phone"
              name="phone"
              type="tel"
              required
              inputmode="tel"
              autocomplete="tel"
              placeholder="55 1234 5678"
              class="mt-2 w-full rounded-md border border-line bg-paper px-4 py-3 text-sm outline-none focus:border-deep"
            />
          </div>
          <div>
            <label for="preferredChannel" class="text-sm font-medium text-ink">
              {t('contact.field.channel')}
            </label>
            <select
              id="preferredChannel"
              name="preferredChannel"
              class="mt-2 w-full rounded-md border border-line bg-paper px-4 py-3 text-sm outline-none focus:border-deep"
            >
              <option value="WHATSAPP" selected>{t('contact.channel.whatsapp')}</option>
              <option value="EMAIL">{t('contact.channel.email')}</option>
              <option value="PHONE">{t('contact.channel.phone')}</option>
            </select>
          </div>
        </div>

        <div>
          <label for="interest" class="text-sm font-medium text-ink">{t('contact.field.interest')}</label>
          <select
            id="interest"
            name="interest"
            class="mt-2 w-full rounded-md border border-line bg-paper px-4 py-3 text-sm outline-none focus:border-deep"
          >
            <option value="">{t('contact.interest.placeholder')}</option>
            {
              interestOptions.map((opt) => (
                <option value={opt.value} selected={prefill.interest === opt.value}>
                  {opt.label}
                </option>
              ))
            }
          </select>
        </div>

        <div>
          <label for="message" class="text-sm font-medium text-ink">{t('contact.field.message')}</label>
          <textarea
            id="message"
            name="message"
            rows="7"
            required
            class="mt-2 w-full rounded-md border border-line bg-paper px-4 py-3 text-sm outline-none focus:border-deep"
          >{prefill.message}</textarea>
        </div>

        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-md bg-gradient-to-r from-deep to-bright px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-deep/15 transition hover:brightness-110"
          data-track-event="CTA Contact Submit"
          data-track-placement="contacto"
        >
          {t('contact.submit')}
        </button>
      </form>

      <aside class="space-y-8">
        <div>
          <h2 class="font-display text-lg font-medium text-ink">{t('contact.aside.title')}</h2>
          <ul class="mt-4 space-y-2 text-sm text-ink-muted">
            <li>
              <a class="link-underline text-deep" href={`mailto:${siteConfig.email}`}>
                {siteConfig.email}
              </a>
            </li>
            <li>
              <a class="link-underline text-deep" href={`${pathForLang(lang)}#colaborar`}>
                {t('contact.aside.collaborate')}
              </a>
            </li>
            <li>
              <a
                class="link-underline text-deep"
                href={`/${altLang}/contacto`}
                hreflang={altLang}
              >
                {t('lang.switch')}
              </a>
            </li>
          </ul>
        </div>
        <p class="text-sm leading-relaxed text-ink-faint">{t('contact.aside.note')}</p>
      </aside>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>
