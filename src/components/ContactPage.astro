---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import type { Lang } from '../i18n/ui';
import { getAlternateLang, pathForLang, useTranslations } from '../i18n/ui';
import { siteConfig } from '../config/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const altLang = getAlternateLang(lang);
const altPath = `/${altLang}/contacto`;
const supportEmail = siteConfig.email;

const interestOptions =
  lang === 'es'
    ? [
        { value: 'criteria', label: 'CriterIA' },
        { value: 'lumo', label: 'Lumo' },
        { value: 'research', label: 'Investigación / co-desarrollo' },
        { value: 'support', label: 'Apoyo / mecenazgo' },
        { value: 'identity', label: 'Identidad / AuraDID' },
        { value: 'otro', label: 'Otro' },
      ]
    : [
        { value: 'criteria', label: 'CriterIA' },
        { value: 'lumo', label: 'Lumo' },
        { value: 'research', label: 'Research / co-development' },
        { value: 'support', label: 'Support / patronage' },
        { value: 'identity', label: 'Identity / AuraDID' },
        { value: 'otro', label: 'Other' },
      ];

const copy =
  lang === 'es'
    ? {
        prefillPrefix: 'Prellenamos el formulario con el contexto de',
        mailtoSubject: 'Contacto desde peranto.app',
        mailtoFail:
          'No pudimos abrir tu cliente de correo. Escríbenos a ' + supportEmail,
      }
    : {
        prefillPrefix: 'We prefilled the form with context from',
        mailtoSubject: 'Contact from peranto.app',
        mailtoFail: 'Could not open your email client. Write to ' + supportEmail,
      };
---

<BaseLayout
  lang={lang}
  title={t('contact.meta.title')}
  description={t('contact.meta.description')}
  alternatePath={altPath}
>
  <Header lang={lang} />
  <main>
    <section class="border-b border-line bg-gradient-to-b from-accent-soft/50 to-paper py-16 sm:py-20">
      <div class="section-width">
        <p class="text-sm font-medium uppercase tracking-wider text-deep">{t('contact.label')}</p>
        <h1 class="mt-3 font-display text-4xl font-medium text-ink sm:text-5xl">{t('contact.title')}</h1>
        <p class="mt-4 max-w-2xl text-lg text-ink-muted">{t('contact.lead')}</p>
      </div>
    </section>

    <section class="section-width grid gap-12 py-16 lg:grid-cols-[1.1fr_0.9fr]">
      <p
        id="contact-success"
        hidden
        class="lg:col-span-2 rounded-md border border-bright/40 bg-accent-soft px-4 py-3 text-sm text-ink"
      >
        {t('contact.success')}
      </p>
      <p
        id="contact-error-missing"
        hidden
        class="lg:col-span-2 rounded-md border border-line bg-paper-dark/60 px-4 py-3 text-sm text-ink"
      >
        {t('contact.error.missing')}
      </p>
      <p
        id="contact-error-generic"
        hidden
        class="lg:col-span-2 rounded-md border border-line bg-paper-dark/60 px-4 py-3 text-sm text-ink"
      >
        {t('contact.error.generic')}{' '}
        <a class="link-underline text-deep" href={`mailto:${supportEmail}`}>{supportEmail}</a>
      </p>
      <p
        id="contact-prefill"
        hidden
        class="lg:col-span-2 rounded-md border border-line bg-accent-soft/40 px-4 py-3 text-sm text-ink"
      >
        {copy.prefillPrefix}
        <strong id="contact-prefill-topic" class="font-semibold"></strong>.
      </p>

      <form
        id="contact-form"
        class="space-y-5"
        method="POST"
        action="/api/contact"
        data-lang={lang}
        data-email={supportEmail}
        data-subject={copy.mailtoSubject}
        data-mailto-fail={copy.mailtoFail}
      >
        <input type="hidden" name="lang" value={lang} />
        <input type="hidden" name="ref" id="contact-ref" value="" />
        <input type="hidden" name="sourcePath" id="contact-path" value="" />
        <input type="hidden" name="topic" id="contact-topic" value="" />

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="text-sm font-medium text-ink">{t('contact.field.name')}</label>
            <input
              id="name"
              name="name"
              required
              class="mt-2 w-full rounded-md border border-line bg-paper px-4 py-3 text-sm outline-none focus:border-deep"
            />
          </div>
          <div>
            <label for="email" class="text-sm font-medium text-ink">{t('contact.field.email')}</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="mt-2 w-full rounded-md border border-line bg-paper px-4 py-3 text-sm outline-none focus:border-deep"
            />
          </div>
        </div>

        <div>
          <label for="company" class="text-sm font-medium text-ink">{t('contact.field.company')}</label>
          <input
            id="company"
            name="company"
            class="mt-2 w-full rounded-md border border-line bg-paper px-4 py-3 text-sm outline-none focus:border-deep"
          />
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="phone" class="text-sm font-medium text-ink">{t('contact.field.phone')}</label>
            <input
              id="phone"
              name="phone"
              type="tel"
              required
              inputmode="tel"
              autocomplete="tel"
              placeholder="55 1234 5678"
              class="mt-2 w-full rounded-md border border-line bg-paper px-4 py-3 text-sm outline-none focus:border-deep"
            />
          </div>
          <div>
            <label for="preferredChannel" class="text-sm font-medium text-ink">
              {t('contact.field.channel')}
            </label>
            <select
              id="preferredChannel"
              name="preferredChannel"
              class="mt-2 w-full rounded-md border border-line bg-paper px-4 py-3 text-sm outline-none focus:border-deep"
            >
              <option value="WHATSAPP" selected>{t('contact.channel.whatsapp')}</option>
              <option value="EMAIL">{t('contact.channel.email')}</option>
              <option value="PHONE">{t('contact.channel.phone')}</option>
            </select>
          </div>
        </div>

        <div>
          <label for="interest" class="text-sm font-medium text-ink">{t('contact.field.interest')}</label>
          <select
            id="interest"
            name="interest"
            class="mt-2 w-full rounded-md border border-line bg-paper px-4 py-3 text-sm outline-none focus:border-deep"
          >
            <option value="">{t('contact.interest.placeholder')}</option>
            {
              interestOptions.map((opt) => (
                <option value={opt.value}>{opt.label}</option>
              ))
            }
          </select>
        </div>

        <div>
          <label for="message" class="text-sm font-medium text-ink">{t('contact.field.message')}</label>
          <textarea
            id="message"
            name="message"
            rows="7"
            required
            class="mt-2 w-full rounded-md border border-line bg-paper px-4 py-3 text-sm outline-none focus:border-deep"
          ></textarea>
        </div>

        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-md bg-gradient-to-r from-deep to-bright px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-deep/15 transition hover:brightness-110"
          data-track-event="CTA Contact Submit"
          data-track-placement="contacto"
        >
          {t('contact.submit')}
        </button>
      </form>

      <aside class="space-y-8">
        <div>
          <h2 class="font-display text-lg font-medium text-ink">{t('contact.aside.title')}</h2>
          <ul class="mt-4 space-y-2 text-sm text-ink-muted">
            <li>
              <a class="link-underline text-deep" href={`mailto:${supportEmail}`}>
                {supportEmail}
              </a>
            </li>
            <li>
              <a class="link-underline text-deep" href={`${pathForLang(lang)}#colaborar`}>
                {t('contact.aside.collaborate')}
              </a>
            </li>
            <li>
              <a
                class="link-underline text-deep"
                href={`/${altLang}/contacto/`}
                hreflang={altLang}
              >
                {t('lang.switch')}
              </a>
            </li>
          </ul>
        </div>
        <p class="text-sm leading-relaxed text-ink-faint">{t('contact.aside.note')}</p>
      </aside>
    </section>
  </main>
  <Footer lang={lang} />

  <script is:inline>
    (function () {
      var form = document.getElementById('contact-form');
      if (!form) return;

      var params = new URLSearchParams(window.location.search);
      var lang = form.getAttribute('data-lang') || 'es';
      var supportEmail = form.getAttribute('data-email') || '';
      var subject = form.getAttribute('data-subject') || 'Contact';
      var mailtoFail = form.getAttribute('data-mailto-fail') || '';

      function show(id) {
        var el = document.getElementById(id);
        if (el) el.hidden = false;
      }

      if (params.get('enviado') === '1') show('contact-success');
      if (params.get('error') === 'missing') show('contact-error-missing');
      if (params.get('error') && params.get('error') !== 'missing') show('contact-error-generic');

      var topic = (params.get('topic') || '').trim();
      var ref = (params.get('ref') || '').trim();
      var path = (params.get('path') || '').trim();
      var interest = (params.get('interest') || '').trim();

      if (topic) {
        var topicInput = document.getElementById('contact-topic');
        var topicLabel = document.getElementById('contact-prefill-topic');
        if (topicInput) topicInput.value = topic;
        if (topicLabel) topicLabel.textContent = ' «' + topic + '»';
        show('contact-prefill');
        var msg = document.getElementById('message');
        if (msg && !msg.value) {
          if (lang === 'en') {
            msg.value =
              'Hello — I was looking at «' +
              topic +
              '» on Peranto and would like to connect.\n\nSpecifically, I\'d like to talk about: ' +
              (path ? '\n\nPage: ' + path : '');
          } else {
            msg.value =
              'Hola — estaba revisando «' +
              topic +
              '» en Peranto y me interesa conectar.\n\nEn concreto, me gustaría hablar sobre: ' +
              (path ? '\n\nPágina: ' + path : '');
          }
        }
      }
      if (ref) {
        var refInput = document.getElementById('contact-ref');
        if (refInput) refInput.value = ref;
      }
      if (path) {
        var pathInput = document.getElementById('contact-path');
        if (pathInput) pathInput.value = path;
      }
      if (interest) {
        var interestEl = document.getElementById('interest');
        if (interestEl) interestEl.value = interest;
      }

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        var data = new FormData(form);
        var name = String(data.get('name') || '').trim();
        var email = String(data.get('email') || '').trim();
        var phone = String(data.get('phone') || '').trim();
        var message = String(data.get('message') || '').trim();
        if (!name || !email || !phone || !message) {
          show('contact-error-missing');
          return;
        }

        var body =
          'Nombre: ' +
          name +
          '\nEmail: ' +
          email +
          '\nOrganización: ' +
          String(data.get('company') || '') +
          '\nTeléfono: ' +
          phone +
          '\nCanal: ' +
          String(data.get('preferredChannel') || '') +
          '\nInterés: ' +
          String(data.get('interest') || '') +
          '\nTema: ' +
          String(data.get('topic') || '') +
          '\n\n' +
          message;

        fetch('/api/contact', { method: 'POST', body: data, redirect: 'manual' })
          .then(function (res) {
            if (res.status >= 200 && res.status < 400) {
              var next = new URL(window.location.href);
              next.searchParams.set('enviado', '1');
              next.searchParams.delete('error');
              window.location.href = next.toString();
              return;
            }
            openMailto(body);
          })
          .catch(function () {
            openMailto(body);
          });
      });

      function openMailto(body) {
        var href =
          'mailto:' +
          encodeURIComponent(supportEmail).replace(/%40/g, '@') +
          '?subject=' +
          encodeURIComponent(subject) +
          '&body=' +
          encodeURIComponent(body);
        window.location.href = href;
        window.setTimeout(function () {
          show('contact-success');
        }, 400);
      }
    })();
  </script>
</BaseLayout>
