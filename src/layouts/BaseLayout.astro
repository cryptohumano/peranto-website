---
import '../styles/global.css';
import SeoJsonLd from '../components/SeoJsonLd.astro';
import type { Lang } from '../i18n/ui';
import { defaultLang, getAlternateLang, useTranslations } from '../i18n/ui';
import Analytics from '../components/Analytics.astro';
import {
  absoluteUrl,
  ghostRssUrl,
  googleSiteVerification,
  seoConfig,
} from '../lib/seo';
import { isAnalyticsEnabled } from '../lib/analytics';
interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Evitar indexación (p. ej. redirecciones temporales) */
  noindex?: boolean;
  ogImage?: string;
}

const { lang, title, description, noindex = false, ogImage } = Astro.props;
const t = useTranslations(lang);
const altLang = getAlternateLang(lang);

const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
const altUrl = new URL(`/${altLang}/`, Astro.site);
const ogImageUrl = absoluteUrl(ogImage ?? seoConfig.ogImagePath);
const rssUrl = ghostRssUrl();
const googleVerification = googleSiteVerification();
const robots = noindex ? 'noindex, follow' : 'index, follow';
const analyticsOn = isAnalyticsEnabled();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {import.meta.env.PROD && (
      <script is:inline>
        if (
          location.protocol === 'http:' &&
          location.hostname !== 'localhost' &&
          !location.hostname.endsWith('.local')
        ) {
          location.replace(location.href.replace(/^http:/, 'https:'));
        }
      </script>
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={seoConfig.themeColor} />
    <meta name="author" content={seoConfig.siteName} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={altLang} href={altUrl} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={new URL(`/${defaultLang}/`, Astro.site)} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={seoConfig.siteName} />
    <meta property="og:locale" content={seoConfig.locale[lang]} />
    <meta
      property="og:locale:alternate"
      content={seoConfig.locale[altLang]}
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(seoConfig.ogImageWidth)} />
    <meta property="og:image:height" content={String(seoConfig.ogImageHeight)} />
    <meta property="og:image:alt" content={pageTitle} />

    <meta name="twitter:card" content={seoConfig.twitterCard} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={pageTitle} />

    {
      rssUrl && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={`${seoConfig.siteName} — ${t('explore.title')}`}
          href={rssUrl}
        />
      )
    }

    {
      googleVerification && (
        <meta name="google-site-verification" content={googleVerification} />
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Source+Sans+3:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <SeoJsonLd
      lang={lang}
      canonical={canonical}
      title={pageTitle}
      description={pageDescription}
    />

    <Analytics />
  </head>
  <body class="min-h-screen" data-analytics={analyticsOn ? 'on' : 'off'}>
    <slot />
  </body>
</html>
