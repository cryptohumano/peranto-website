---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const pageTitle = `${title} — Peranto Admin`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-paper font-sans text-ink antialiased">
    <header class="border-b border-line bg-night text-white">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <div class="flex items-center gap-4">
          <a href="/admin" class="font-display text-lg font-medium tracking-tight">
            Peranto <span class="text-bright">CRM</span>
          </a>
          <nav class="hidden text-sm text-white/70 sm:block">
            <a href="/admin" class="hover:text-white">Leads</a>
          </nav>
        </div>
        <form method="POST" action="/api/admin/logout">
          <button
            type="submit"
            class="rounded-md border border-white/20 px-3 py-1.5 text-sm text-white/80 transition hover:border-bright/50 hover:text-white"
          >
            Salir
          </button>
        </form>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
