---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Thesis from '../../components/Thesis.astro';
import Pillars from '../../components/Pillars.astro';
import Research from '../../components/Research.astro';
import Principles from '../../components/Principles.astro';
import Explore from '../../components/Explore.astro';
import Collaborate from '../../components/Collaborate.astro';
import Footer from '../../components/Footer.astro';

const lang = 'es';
---

<BaseLayout lang={lang}>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <Thesis lang={lang} />
    <Pillars lang={lang} />
    <Research lang={lang} />
    <Principles lang={lang} />
    <Explore lang={lang} />
    <Collaborate lang={lang} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
