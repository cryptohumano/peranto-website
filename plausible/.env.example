# URL pública de tu instancia (subdominio recomendado)
BASE_URL=https://analytics.peranto.app

# Genera uno nuevo: openssl rand -base64 48
SECRET_KEY_BASE=cambiar_por_secreto_largo_aleatorio

# invite_only | true | false — usa true tras crear tu usuario admin
DISABLE_REGISTRATION=invite_only

# Puerto interno (debe coincidir con compose.override.yml)
HTTP_PORT=8000
